FROM python:3.12-slim
WORKDIR /opt/scraper-swarm

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential && \
    rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

COPY pyproject.toml uv.lock ./
COPY apps/swarmd ./apps/swarmd
COPY apps/panel-api ./apps/panel-api
COPY apps/gateway ./apps/gateway

RUN uv sync --package panel-api

ENV PATH="/opt/scraper-swarm/.venv/bin:$PATH"
EXPOSE 8000

CMD ["uvicorn", "panel_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
