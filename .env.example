# Scraper Swarm — operator environment (ticket #7).
# Copy to .env and fill in before `docker compose up`. All values optional;
# defaults keep a local deployment working.

# Public origin of the MCP gateway, used when issuing agent keys so the
# opencode snippet points at the real endpoint. Empty/unset (or an
# example.com / REPLACE-ME host) yields a conspicuous REPLACE-ME placeholder
# and key creation requires allow_placeholder_host=true.
SWARM_PUBLIC_MCP_URL=https://swarm.example.com/mcp

# External domain served by Caddy (TLS + routing). Defaults to localhost.
SWARM_DOMAIN=localhost

# Bootstrap token for the first admin (consumed once, then disabled).
SWARM_BOOTSTRAP_TOKEN=

# Gateway engine overrides (defaults suit the compose stack).
# SEARXNG_URL=http://searxng:8080
# CRAWL4AI_URL=http://crawl4ai:11235
# SCRAPLING_URL=http://scrapling:8000
# GPT_RESEARCHER_URL=http://gpt-researcher:8000

# SSRF resolver posture: fail closed on unresolvable names / resolver
# outages (default). Set to 0 to delegate those to Smokescreen only.
# SWARM_SSRF_RESOLVER_FAIL_CLOSED=1

# Cap on fetched result text per call (bytes). Over-cap results truncate
# with a marker.
# SWARM_MAX_FETCH_BYTES=3145728

# Audit query privacy (ticket #10): verbatim (default), hashed (salted HMAC
# correlation), or redacted (length + category). Per-key override at issuance
# (--audit-mode / audit_query_mode).
# SWARM_AUDIT_QUERY_MODE=verbatim
# Server-held HMAC salt. REQUIRED when any key uses hashed mode (missing
# salt falls back to redacted). Generate once, persist, back up with secrets:
# python3 -c "import secrets; print(secrets.token_hex(32))"
# SWARM_AUDIT_HMAC_SALT=
# Audit retention in days (0/unset disables). Prune with:
# docker compose exec panel-api swarmctl audit prune
# (uses this default unless --retention-days is passed).
# SWARM_AUDIT_RETENTION_DAYS=
